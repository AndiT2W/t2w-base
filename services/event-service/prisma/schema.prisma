generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MITARBEITER
}

enum OrganizerType {
  ORGANISATION
  PERSON
}

enum EventStatus {
  ANFRAGE
  ANGEBOT_GESENDET
  ZUGESAGT
  ABGESAGT
  AKQUISE
  DATUM_PRUEFEN
}

enum SyncStatus {
  NEVER
  SYNCING
  SUCCESS
  ERROR
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  displayName  String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MITARBEITER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
  auditEntries AuditLog[]
  events       Event[]  @relation("EventUpdatedBy")
  sessions     Session[]
}

model Organizer {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  type         OrganizerType
  active       Boolean     @default(true)
  billingInfo  String?
  payoutInfo   String?
  country      String?
  city         String?
  street       String?
  postalCode   String?
  uid          String?
  iban         String?
  bic          String?
  bankName     String?
  email        String?
  personId     String?     @unique @db.Uuid
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  events       Event[]
  contacts     OrganizerContact[]
  person       Contact?    @relation("CustomerPerson", fields: [personId], references: [id], onDelete: SetNull)
  payoutEvents Event[]     @relation("EventPayoutRecipient")
  invoiceRecipients EventInvoiceRecipient[]
  @@index([name])
}

model Contact {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  firstName   String?
  lastName    String?
  note        String?
  function    String?
  location    String?
  archived    Boolean             @default(false)
  syncSource  String?
  externalId  String?
  syncStatus  SyncStatus          @default(NEVER)
  lastSyncedAt DateTime?
  email       String?
  phone       String?
  privatePhone String?
  workPhone   String?
  country     String?
  city        String?
  street      String?
  postalCode  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  organizers  OrganizerContact[]
  eventRoles  EventContact[]
  customerProfile Organizer? @relation("CustomerPerson")
}

model OrganizerContact {
  organizerId String @db.Uuid
  contactId   String @db.Uuid
  role        String?
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Restrict)
  @@id([organizerId, contactId])
}

model Sport {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
  @@unique([name])
}

model Event {
  id                    String      @id @default(uuid()) @db.Uuid
  eventCode             String      @unique
  name                  String
  status                EventStatus  @default(ANFRAGE)
  organizerId           String?     @db.Uuid
  payoutRecipientId     String?     @db.Uuid
  sportId               String?     @db.Uuid
  startAt               DateTime
  endAt                 DateTime
  location              String?
  responsible           String?
  participantForecast   Int?
  participantCurrent    Int?
  notes                 String?
  outlookFolder         String?
  outlookWebUrl         String?
  outlookMailbox        String?
  outlookRootFolderId   String?
  outlookYearFolderId   String?
  outlookQuarterFolderId String?
  outlookFolderId       String?
  outlookFolderSyncStatus SyncStatus @default(NEVER)
  outlookFolderLastSuccessAt DateTime?
  outlookFolderLastError String?
  sharepointFolder      String?
  archived              Boolean     @default(false)
  archivedAt            DateTime?
  t2wEventId            Int?
  time2winSyncStatus    SyncStatus  @default(NEVER)
  time2winLastSuccessAt DateTime?
  time2winLastError     String?
  version               Int         @default(1)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  updatedById           String?     @db.Uuid
  organizer             Organizer?  @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  payoutRecipient       Organizer?  @relation("EventPayoutRecipient", fields: [payoutRecipientId], references: [id], onDelete: SetNull)
  sport                 Sport?      @relation(fields: [sportId], references: [id], onDelete: SetNull)
  updatedBy             User?       @relation("EventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  contacts              EventContact[]
  invoiceRecipients     EventInvoiceRecipient[]
  tasks                 EventTask[]
  files                 EventFile[]
  activities            EventActivity[]
  @@index([status, archived])
  @@index([startAt, endAt])
}

model EventTask {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  title       String
  dueAt       DateTime?
  responsible String?
  completed   Boolean  @default(false)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventFile {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  name      String
  url       String?
  size      String?
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventActivity {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  channel   String
  subject   String
  author    String?
  body      String?
  occurredAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventInvoiceRecipient {
  eventId     String @db.Uuid
  organizerId String @db.Uuid
  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  @@id([eventId, organizerId])
}

model EventContact {
  eventId   String @db.Uuid
  contactId String @db.Uuid
  role      String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  @@id([eventId, contactId, role])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entity     String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([entity, entityId])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model AppSettings {
  id                  Int      @id @default(1)
  outlookJahresordner Json     @default("[]")
  jahresSites         Json     @default("[]")
  outlookMailbox      String?
  outlookRootFolderId String?
  updatedAt           DateTime @updatedAt
}
