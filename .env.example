EVENT_DB_NAME=t2w_events
EVENT_DB_USER=t2w_events
EVENT_DB_PASSWORD=replace-with-a-long-random-password
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-initial-password
# Public frontend URL used in invitation, password-reset and email-confirmation links.
APP_BASE_URL=http://localhost:4173
OUTLOOK_TENANT_ID=your-entra-tenant-id
OUTLOOK_CLIENT_ID=your-entra-client-id
OUTLOOK_CLIENT_SECRET=configure-outside-the-repository
# Mailbox used as sender for account-security notifications.
SECURITY_MAIL_SENDER=security@example.com
# Optional local/test override; use Entra client credentials in production.
# OUTLOOK_GRAPH_ACCESS_TOKEN=
# Server-only mail classification. Ollama Cloud keys must never reach browser code.
# OLLAMA_API_KEY=configure-outside-the-repository
# OLLAMA_CLOUD_MODEL=gemma4:31b
# OLLAMA_API_URL=https://ollama.com/api/chat
TIME2WIN_API_KEY=configure-outside-the-repository
# Optional. Defaults to https://time2win.at/api/1.1; set this to
# https://data-hub.time2win.at to synchronize through the Data Hub.
# TIME2WIN_API_BASE_URL=https://time2win.at/api/1.1
